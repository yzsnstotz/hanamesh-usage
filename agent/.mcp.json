{
  "mcpServers": {
    "hanamesh": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec /bin/sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?HANAMESH_PLUGIN_ROOT_REQUIRED}}/bin/hm-agent\" mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "HANAMESH_SHARED_HOME",
        "HANAMESH_AGENT_HOME",
        "HANAMESH_AGENT_CHANNEL",
        "CODEX_HOME"
      ]
    }
  }
}
