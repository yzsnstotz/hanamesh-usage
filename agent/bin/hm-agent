#!/bin/sh
# macOS bootstrap uses only built-in Perl while fixed Node prepares asynchronously.
set -eu
umask 077
[ -n "${1:-}" ] || { printf '%s\n' HANAMESH_AGENT_ACTION_REQUIRED >&2; exit 1; }
plugin=$(CDPATH= cd -- "$(/usr/bin/dirname "$0")/.." && pwd -P)
exec /usr/bin/env LC_ALL=C /usr/bin/perl "$plugin/bin/runtime-bootstrap.pl" "$@"
