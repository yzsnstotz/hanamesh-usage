{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?HANAMESH_PLUGIN_ROOT_REQUIRED}}/bin/hm-agent\" hook --event SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?HANAMESH_PLUGIN_ROOT_REQUIRED}}/bin/hm-agent\" hook --event PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?HANAMESH_PLUGIN_ROOT_REQUIRED}}/bin/hm-agent\" hook --event PostToolUseFailure"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?HANAMESH_PLUGIN_ROOT_REQUIRED}}/bin/hm-agent\" hook --event PreToolUse"
          }
        ]
      }
    ]
  }
}
