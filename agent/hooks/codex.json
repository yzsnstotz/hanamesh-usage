{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hm-agent\" hook --event SessionStart",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& ([IO.Path]::Combine($env:PLUGIN_ROOT, 'bin/hm-agent.ps1')) hook --event SessionStart; exit $LASTEXITCODE\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hm-agent\" hook --event PostToolUse",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& ([IO.Path]::Combine($env:PLUGIN_ROOT, 'bin/hm-agent.ps1')) hook --event PostToolUse; exit $LASTEXITCODE\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/hm-agent\" hook --event PreToolUse",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& ([IO.Path]::Combine($env:PLUGIN_ROOT, 'bin/hm-agent.ps1')) hook --event PreToolUse; exit $LASTEXITCODE\""
          }
        ]
      }
    ]
  }
}
