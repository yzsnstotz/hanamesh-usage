{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "declaration": true,
    "rootDir": "src/core",
    "outDir": "lib/core"
  },
  "include": [
    "src/core/**/*.ts"
  ]
}
