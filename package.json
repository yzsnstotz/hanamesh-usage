{
  "name": "@hanamesh/usage",
  "version": "0.3.0-rc.12",
  "description": "Consent-gated, device-signed HanaMesh usage events for DSH",
  "type": "module",
  "main": "lib/host/index.js",
  "types": "lib/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host/index.d.ts",
      "default": "./lib/host/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/core",
    "lib/host",
    "lib/client.js",
    "lib/client/index.d.ts",
    "profile",
    "README.md",
    "LICENSE",
    "consistency.json",
    "lib/agent",
    "agent",
    "tools/package-agent.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzsnstotz/hanamesh-usage.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "external": [
        "react"
      ],
      "immediately": true
    }
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <4.1.0-0 || >=4.0.5-alpha.1 <4.1.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-storage": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.1-0 <0.3.0-0",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:offline": "node tools/build.mjs --offline",
    "test": "node --test --test-reporter=tap tests/*.test.mjs tests/crash/*.test.mjs",
    "test:mutations": "node tools/mutations.mjs",
    "check": "node tools/check.mjs",
    "preflight:host": "node tools/preflight.mjs",
    "samples": "node tools/samples.mjs",
    "test:detached": "node tools/detached.mjs",
    "test:contract": "pnpm run build && node --test --test-reporter=tap tests/stage0-contract.test.mjs tests/stage4-contract.test.mjs tests/contract-wire.test.mjs tests/shared-fact.test.mjs",
    "package:agent": "node tools/package-agent.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "24.13.4",
    "@types/react": "18.3.1",
    "js-yaml": "4.1.1",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
